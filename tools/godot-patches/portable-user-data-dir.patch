 String OS_Windows::get_user_data_dir(const String &p_user_dir) const {
+#ifndef TOOLS_ENABLED
+	// Asylum portable build: user:// is the "userdata" folder next to the executable, so the
+	// exported game leaves no traces in %APPDATA%.
+	return get_executable_path().get_base_dir().path_join("userdata").replace_char('\\', '/');
+#else
 	return get_data_path().path_join(p_user_dir).replace_char('\\', '/');
+#endif
 }
 
